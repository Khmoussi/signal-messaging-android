<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kadi_splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kadi_splash_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <FrameLayout
            android:layout_width="168dp"
            android:layout_height="168dp">

            <ImageView
                android:id="@+id/kadi_splash_ripple"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_splash_ripple" />

            <ImageView
                android:id="@+id/kadi_splash_logo"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_kadi_logo" />

            <ImageView
                android:id="@+id/kadi_splash_sparkle"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="42dp"
                android:layout_marginEnd="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_splash_sparkle" />
        </FrameLayout>

        <TextView
            android:id="@+id/kadi_splash_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/ibm_plex_sans_arabic_light"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/kadi_splash_wordmark"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textDirection="locale"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/kadi_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.7"
            android:fontFamily="@font/ibm_plex_sans_arabic_light"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/kadi_splash_tagline"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textDirection="locale"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
